<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBrush" Color="#111318" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#191C22" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#232731" />
  <SolidColorBrush x:Key="BorderBrush" Color="#343944" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="#5AA9FF" />
  <SolidColorBrush x:Key="TextBrush" Color="#F3F5F7" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#AEB6C2" />
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
  </Style>
</ResourceDictionary>