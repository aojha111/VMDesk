    <!-- The pack is fixed-colour artwork, so it cannot inherit Foreground the way a Segoe MDL2
         glyph does. On a neutral surface the colours are kept (PackIcon). On a filled/accent
         surface those colours collide with the fill, so the glyph is rendered as a silhouette
         tinted by the surrounding foreground (TintedPackIcon plus an inline OpacityMask), which
         keeps the pack's shape and stays legible in both themes. -->
    <Style x:Key="PackIcon" TargetType="Image">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>
    <Style x:Key="TintedPackIcon" TargetType="Rectangle">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>
</ResourceDictionary>
