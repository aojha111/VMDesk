<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light Theme - Windows 11 Fluent -->
  <SolidColorBrush x:Key="WindowBrush" Color="#F3F3F3" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FBFBFB" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F6F6F6" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EDEDED" />
  <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#D1D1D1" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="#005FB8" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1A6CC4" />
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#0054A6" />
  <SolidColorBrush x:Key="FocusBrush" Color="#005FB8" />
  <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3F3F3F" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#606060" />
  <SolidColorBrush x:Key="DisabledBrush" Color="#A0A0A0" />
  <SolidColorBrush x:Key="AccentBrush" Color="#005FB8" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
  <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
  <SolidColorBrush x:Key="HeroStartBrush" Color="#005FB8" />
  <SolidColorBrush x:Key="HeroEndBrush" Color="#004A94" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#80000000" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#33005FB8" />
  <!-- Win11 control fill (the slightly-translucent button background over Mica) -->
  <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlSecondaryBrush" Color="#F9F9F9" />
  <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0F000000" />
  <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0A000000" />
  
  <!-- Shadows and effects -->
  <DropShadowEffect x:Key="ShadowSmall" BlurRadius="4" ShadowDepth="1" Opacity="0.06" Direction="270" Color="#000000" />
  <DropShadowEffect x:Key="ShadowMedium" BlurRadius="12" ShadowDepth="4" Opacity="0.09" Direction="270" Color="#000000" />
  <DropShadowEffect x:Key="ShadowLarge" BlurRadius="24" ShadowDepth="8" Opacity="0.12" Direction="270" Color="#000000" />
  
  <!-- Corner radius -->
  <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
  <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="CornerRadiusFull">999</CornerRadius>
</ResourceDictionary>
