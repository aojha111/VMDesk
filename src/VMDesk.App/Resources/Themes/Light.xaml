<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light Theme - Windows 11 style -->
  <SolidColorBrush x:Key="WindowBrush" Color="#F3F3F3" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F0F0F0" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E8E8E8" />
  <SolidColorBrush x:Key="BorderBrush" Color="#D8D8D8" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#C0C0C0" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="#0067C0" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#005A9E" />
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#004C80" />
  <SolidColorBrush x:Key="FocusBrush" Color="#0067C0" />
  <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#404040" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#606060" />
  <SolidColorBrush x:Key="DisabledBrush" Color="#9E9E9E" />
  <SolidColorBrush x:Key="AccentBrush" Color="#0F6D8C" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32" />
  <SolidColorBrush x:Key="WarningBrush" Color="#F57F17" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />
  <SolidColorBrush x:Key="HeroStartBrush" Color="#0067C0" />
  <SolidColorBrush x:Key="HeroEndBrush" Color="#00549D" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#80000000" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#2688CC33" />
  
  <!-- Shadows and effects -->
  <DropShadowEffect x:Key="ShadowSmall" BlurRadius="4" ShadowDepth="1" Opacity="0.08" Direction="270" Color="#000000" />
  <DropShadowEffect x:Key="ShadowMedium" BlurRadius="12" ShadowDepth="4" Opacity="0.12" Direction="270" Color="#000000" />
  <DropShadowEffect x:Key="ShadowLarge" BlurRadius="24" ShadowDepth="8" Opacity="0.16" Direction="270" Color="#000000" />
  
  <!-- Corner radius -->
  <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
  <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="CornerRadiusFull">999</CornerRadius>
</ResourceDictionary>