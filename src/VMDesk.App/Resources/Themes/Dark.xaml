<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dark Theme - Windows 11 style -->
  <SolidColorBrush x:Key="WindowBrush" Color="#1B1B1B" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#252525" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#2D2D2D" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#383838" />
  <SolidColorBrush x:Key="BorderBrush" Color="#3E3E3E" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#4A4A4A" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0082E6" />
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#006BB8" />
  <SolidColorBrush x:Key="FocusBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D0D0D0" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#9E9E9E" />
  <SolidColorBrush x:Key="DisabledBrush" Color="#6E6E6E" />
  <SolidColorBrush x:Key="AccentBrush" Color="#0F6D8C" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFB300" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#EF5350" />
  <SolidColorBrush x:Key="HeroStartBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="HeroEndBrush" Color="#006BB8" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#A0000000" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#2688CC33" />
  
  <!-- Shadows and effects -->
  <DropShadowEffect x:Key="ShadowSmall" BlurRadius="4" ShadowDepth="1" Opacity="0.15" Direction="270" Color="#000000" />
  <DropShadowEffect x:Key="ShadowMedium" BlurRadius="12" ShadowDepth="4" Opacity="0.25" Direction="270" Color="#000000" />
  <DropShadowEffect x:Key="ShadowLarge" BlurRadius="24" ShadowDepth="8" Opacity="0.35" Direction="270" Color="#000000" />
  
  <!-- Corner radius -->
  <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
  <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="CornerRadiusFull">999</CornerRadius>
</ResourceDictionary>