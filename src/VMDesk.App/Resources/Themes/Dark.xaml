<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dark Theme - Windows 11 Fluent -->
  <SolidColorBrush x:Key="WindowBrush" Color="#202020" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#272727" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#2D2D2D" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#323232" />
  <SolidColorBrush x:Key="BorderBrush" Color="#383838" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#4D4D4D" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="#005FB8" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1A6CC4" />
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#2E78C8" />
  <SolidColorBrush x:Key="FocusBrush" Color="#4CC2FF" />
  <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#DCDCDC" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#A9A9A9" />
  <SolidColorBrush x:Key="DisabledBrush" Color="#6E6E6E" />
  <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#FF8484" />
  <SolidColorBrush x:Key="HeroStartBrush" Color="#005FB8" />
  <SolidColorBrush x:Key="HeroEndBrush" Color="#004280" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#A0000000" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#334CC2FF" />
  <!-- Win11 control fill (translucent white over the dark Mica backdrop) -->
  <SolidColorBrush x:Key="ControlBrush" Color="#2D2D2D" />
  <SolidColorBrush x:Key="ControlSecondaryBrush" Color="#2B2B2B" />
  <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF" />
  
  <!-- Shadows and effects -->
  <DropShadowEffect x:Key="ShadowSmall" BlurRadius="4" ShadowDepth="1" Opacity="0.20" Direction="270" Color="#000000" />
  <DropShadowEffect x:Key="ShadowMedium" BlurRadius="12" ShadowDepth="4" Opacity="0.30" Direction="270" Color="#000000" />
  <DropShadowEffect x:Key="ShadowLarge" BlurRadius="24" ShadowDepth="8" Opacity="0.40" Direction="270" Color="#000000" />
  
  <!-- Corner radius -->
  <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
  <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="CornerRadiusFull">999</CornerRadius>
</ResourceDictionary>
