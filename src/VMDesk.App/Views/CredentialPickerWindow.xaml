<Window x:Class="VMDesk.App.Views.CredentialPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a credential"
        Width="460"
        SizeToContent="Height"
        MinWidth="420"
        MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Icon="{DynamicResource Icon.App}">

    <Border Style="{DynamicResource Card}" Margin="20" Padding="24">
        <StackPanel>
            <TextBlock Text="Select a saved credential"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="This VM has no credential assigned yet. Credentials are managed in Windows Credential Manager."
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="13"
                       Margin="0,6,0,18"
                       TextWrapping="Wrap" />

            <TextBlock Text="Credential" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
            <ComboBox x:Name="CredentialBox"
                      DisplayMemberPath="Reference"
                      Padding="14,10"
                      MinHeight="42"
                      FontSize="14" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Manage credentials…"
                        Click="ManageClick"
                        Style="{DynamicResource GhostButton}"
                        Padding="16,8" />
                <Button x:Name="UseButton"
                        Content="Use selected"
                        IsDefault="True"
                        Click="UseClick"
                        Style="{DynamicResource PrimaryButton}"
                        Padding="20,8"
                        Margin="12,0,0,0"
                        MinWidth="120" />
                <Button Content="Cancel"
                        IsCancel="True"
                        Style="{DynamicResource SecondaryButton}"
                        Padding="16,8"
                        Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
