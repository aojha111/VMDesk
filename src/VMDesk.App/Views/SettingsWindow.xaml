<Window x:Class="VMDesk.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="620" Height="470" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Tune the workspace for the way your team connects." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,20"/></StackPanel>
    <Border Grid.Row="1" Padding="22" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"><StackPanel>
      <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
      <TextBlock Text="Theme" FontWeight="SemiBold"/><ComboBox x:Name="ThemeBox" Margin="0,6,0,20"><ComboBoxItem Content="Ocean Blue" Tag="System"/><ComboBoxItem Content="Light" Tag="Light"/><ComboBoxItem Content="Dark Slate Emerald" Tag="Dark"/></ComboBox>
      <TextBlock Text="Navigation" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox Content="Keep the navigation expanded" IsChecked="True"/><CheckBox Content="Reconnect sessions when the app starts" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Apply" Click="ApplyClick" Background="{DynamicResource PrimaryBrush}" Foreground="White"/><Button Content="Close" IsCancel="True" Click="CloseClick"/></StackPanel>
  </Grid>
</Window>