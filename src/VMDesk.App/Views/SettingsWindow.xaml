<Window x:Class="VMDesk.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="620" Height="420" MinWidth="540" MinHeight="400" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,24"><TextBlock Text="Appearance" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Make your workspace feel at home." Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"/></StackPanel>
    <Border Grid.Row="1" Padding="20" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Top">
      <StackPanel>
        <TextBlock Text="App theme" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="Choose a light or dark appearance, or use your Windows app setting." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,16"/>
        <ComboBox x:Name="ThemeBox" AutomationProperties.Name="App theme" SelectedValuePath="Tag">
          <ComboBoxItem Content="Use Windows setting" Tag="System"/>
          <ComboBoxItem Content="Light" Tag="Light"/>
          <ComboBoxItem Content="Dark" Tag="Dark"/>
        </ComboBox>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="Close" IsCancel="True" Click="CloseClick" MinWidth="90"/>
      <Button x:Name="ApplyButton" Content="Apply" IsDefault="True" Click="ApplyClick" Background="{DynamicResource PrimaryBrush}" Foreground="White" MinWidth="90" Margin="0"/>
    </StackPanel>
  </Grid>
</Window>