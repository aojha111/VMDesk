<Window x:Class="VMDesk.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings"
        Width="640"
        Height="480"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        Icon="{DynamicResource Icon.App}">

    <Border Style="{DynamicResource Card}" Margin="24" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="32,28,32,16">
                <TextBlock Text="Settings"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="Customize your VMDesk experience"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,6,0,0"
                           FontSize="14" />
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,32,24">
                <StackPanel>
                    <!-- Appearance Section -->
                    <GroupBox Header="Appearance" Style="{DynamicResource GroupBoxStyle}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Choose a light or dark appearance, or use your Windows app setting."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Margin="0,0,0,16" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <RadioButton Content="Use Windows setting"
                                             GroupName="Theme"
                                             Tag="System"
                                             FontSize="14"
                                             Margin="0,0,24,8"
                                             Checked="ThemeRadio_Checked" />
                                <RadioButton Content="Light"
                                             GroupName="Theme"
                                             Tag="Light"
                                             FontSize="14"
                                             Margin="0,0,24,8"
                                             Checked="ThemeRadio_Checked" />
                                <RadioButton Content="Dark"
                                             GroupName="Theme"
                                             Tag="Dark"
                                             FontSize="14"
                                             Checked="ThemeRadio_Checked" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Library Section -->
                    <GroupBox Header="Library" Style="{DynamicResource GroupBoxStyle}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Configure how VMs are displayed and organized"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Margin="0,0,0,16" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <RadioButton Content="Tile view (cards)"
                                             GroupName="LibraryView"
                                             Tag="Tile"
                                             FontSize="14"
                                             Margin="0,0,24,8"
                                             Checked="LibraryViewRadio_Checked" />
                                <RadioButton Content="List view (table)"
                                             GroupName="LibraryView"
                                             Tag="List"
                                             FontSize="14"
                                             Checked="LibraryViewRadio_Checked" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Confirmation Section -->
                    <GroupBox Header="Confirmations" Style="{DynamicResource GroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="Require confirmation before removing VMs from the library"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Margin="0,0,0,12" />

                            <CheckBox x:Name="ConfirmDeleteBox"
                                      Content="Confirm before deleting VMs"
                                      FontSize="14"
                                      IsChecked="True" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            IsCancel="True"
                            Style="{DynamicResource SecondaryButton}"
                            Padding="20,10"
                            MinWidth="100" />
                    <Button x:Name="ApplyButton"
                            IsDefault="True"
                            Style="{DynamicResource PrimaryButton}"
                            Padding="24,10"
                            MinWidth="120"
                            Margin="12,0,0,0"
                            Click="ApplyClick">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Style="{StaticResource TintedPackIcon}"
                                       Width="16" Height="16" Fill="White">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{StaticResource Icon.Ok}" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Apply"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
