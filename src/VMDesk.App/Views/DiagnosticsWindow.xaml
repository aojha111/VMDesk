<Window x:Class="VMDesk.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics" Width="720" Height="520" MinWidth="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
  <DockPanel Margin="28">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Close" IsCancel="True" Click="CloseClick" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Diagnostics" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20" />
        <ItemsControl ItemsSource="{Binding}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>