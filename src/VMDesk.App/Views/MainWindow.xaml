<Window x:Class="VMDesk.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:VMDesk.App.Converters"
        xmlns:vm="clr-namespace:VMDesk.Core.Entities"
        mc:Ignorable="d"
        Title="VMDesk" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Icon="{DynamicResource AppIcon}">
  
  <Window.Resources>
    <ResourceDictionary>
      <converters:ViewModeVisibilityConverter x:Key="ViewModeVisibility" />
      <converters:ConnectionStateToBrushConverter x:Key="ConnectionStateBrush" />
      <converters:ConnectionStateToTextConverter x:Key="ConnectionStateText" />
      <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
      <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
      <converters:BoolToFavoriteTooltipConverter x:Key="BoolToFavoriteTooltip" />
      <converters:BoolToFavoriteIconConverter x:Key="BoolToFavoriteIcon" />
      <converters:BoolToFavoriteColorConverter x:Key="BoolToFavoriteColor" />
      <converters:ViewToIconConverter x:Key="ViewToIcon" />
      <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
      <!-- VM Tile DataTemplate -->
      <DataTemplate x:Key="VmTileTemplate">
      <Border Style="{DynamicResource CardHover}"
              Width="300" MinHeight="180" Margin="0,0,16,16"
              Padding="0">
        <Border.ToolTip>
          <MultiBinding StringFormat="Host: {0}:{1}">
            <Binding Path="Host" />
            <Binding Path="Port" />
          </MultiBinding>
        </Border.ToolTip>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          
          <!-- Header with icon, name, favorite -->
          <Grid Grid.Row="0" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <!-- VM Type Icon -->
            <Border Width="44" Height="44" CornerRadius="12"
                    Background="{DynamicResource PrimaryBrush}">
              <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                         FontSize="20" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}"
                         FontSize="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="12"
                         Foreground="{DynamicResource MutedTextBrush}"
                         TextTrimming="CharacterEllipsis"
                         Margin="0,2,0,0">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0}:{1}">
                    <Binding Path="Host" />
                    <Binding Path="Port" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
            
            <!-- Favorite Button -->
            <Button Grid.Column="2"
                    Style="{DynamicResource GhostButton}"
                    Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Favorite, Converter={StaticResource BoolToFavoriteTooltip}}"
                    Width="36" Height="36" Padding="0" Margin="0">
              <TextBlock Text="{Binding Favorite, Converter={StaticResource BoolToFavoriteIcon}}"
                         FontFamily="Segoe MDL2 Assets"
                         FontSize="16"
                         Foreground="{Binding Favorite, Converter={StaticResource BoolToFavoriteColor}}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>
          
          <!-- Details -->
          <StackPanel Grid.Row="1" Margin="16,4,16,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Width="28" Height="28" CornerRadius="8"
                      Background="{DynamicResource SurfaceRaisedBrush}">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                           FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding Username}"
                         FontSize="13"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="10,0,0,0"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            
            <!-- Tags/Capabilities -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Border Style="{DynamicResource Tag}" Visibility="{Binding DriveRedirection, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE8B7; Drives" FontFamily="Segoe MDL2 Assets" FontSize="10" />
              </Border>
              <Border Style="{DynamicResource Tag}" Visibility="{Binding ClipboardRedirection, Converter={StaticResource BoolToVis}}" Margin="6,0,0,0">
                <TextBlock Text="&#xE70F; Clipboard" FontFamily="Segoe MDL2 Assets" FontSize="10" />
              </Border>
              <Border Style="{DynamicResource Tag}" Visibility="{Binding AudioRedirection, Converter={StaticResource BoolToVis}}" Margin="6,0,0,0">
                <TextBlock Text="&#xE772; Audio" FontFamily="Segoe MDL2 Assets" FontSize="10" />
              </Border>
            </StackPanel>
          </StackPanel>
          
          <!-- Footer with status and actions -->
          <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="16,0,16,0">
            <Grid Margin="16,12,16,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              
              <!-- Connection Status -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{Binding State, Converter={StaticResource ConnectionStateBrush}}" />
                <TextBlock Text="{Binding State, Converter={StaticResource ConnectionStateText}}"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
              </StackPanel>
              
              <!-- Last Connected -->
              <TextBlock Grid.Column="1"
                         Text="{Binding LastConnectedAt, StringFormat='Last: {}{0:g}', ConverterCulture='en-US'}"
                         FontSize="11"
                         Foreground="{DynamicResource MutedTextBrush}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Visibility="{Binding LastConnectedAt, Converter={StaticResource BoolToVis}}" />
              
              <!-- Action Buttons -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource GhostButton}"
                        Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="Connect"
                        Width="36" Height="36" Padding="0">
                  <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets"
                             FontSize="14" Foreground="{DynamicResource PrimaryBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Style="{DynamicResource GhostButton}"
                        Click="EditVmClick"
                        CommandParameter="{Binding}"
                        Tag="{Binding}"
                        ToolTip="Edit VM"
                        Width="36" Height="36" Padding="0" Margin="4,0,0,0">
                  <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                             FontSize="14" Foreground="{DynamicResource TextBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Style="{DynamicResource DangerButton}"
                        Command="{Binding DataContext.DeleteVmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="Remove VM"
                        Width="36" Height="36" Padding="0" Margin="4,0,0,0">
                  <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                             FontSize="14" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>
          
          <!-- Connecting Overlay -->
          <Border Grid.RowSpan="3"
                  Background="{DynamicResource OverlayBrush}"
                  Visibility="{Binding State, Converter={StaticResource ConnectionStateToVisibility}, ConverterParameter=Connecting}"
                  CornerRadius="{DynamicResource CornerRadiusMedium}">
            <Grid>
              <Border Style="{DynamicResource LoadingSpinner}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Text="Connecting..."
                         FontSize="13"
                         Foreground="White"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,40,0,0" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
      </ResourceDictionary>
  </Window.Resources>
  
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    
    <!-- Sidebar -->
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="16,16,16,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          
          <Button x:Name="CollapseIcon"
                  Click="CollapseSidebarClick"
                  HorizontalAlignment="Left"
                  ToolTip="Collapse navigation"
                  AutomationProperties.Name="Toggle navigation"
                  Width="40" Height="40"
                  Style="{DynamicResource IconButton}"
                  Margin="0,0,8,0">
            <Path Data="M 0,4 L 5,9 L 10,4"
                  Stroke="{DynamicResource TextBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Width="14" Height="12" Stretch="None"
                  x:Name="CollapseChevron" />
          </Button>
          
          <StackPanel Grid.Column="1" VerticalAlignment="Center" x:Name="SidebarHeaderContent">
            <TextBlock Text="VMDesk" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="{Binding CountLabel}"
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
        
        <!-- Navigation -->
        <StackPanel x:Name="SidebarMenu" Grid.Row="1" Margin="12,0,12,8">
          <Button Tag="All" Click="ScopeClick"
                  Style="{StaticResource NavigationButton}"
                  ToolTip="All VMs">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="28" VerticalAlignment="Center" />
              <TextBlock Text="All VMs" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" />
            </StackPanel>
          </Button>
          <Button Tag="Favorites" Click="ScopeClick"
                  Style="{StaticResource NavigationButton}"
                  ToolTip="Favorites">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="28" VerticalAlignment="Center" />
              <TextBlock Text="Favorites" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" />
            </StackPanel>
          </Button>
          <Button Tag="Recent" Click="ScopeClick"
                  Style="{StaticResource NavigationButton}"
                  ToolTip="Recent connections">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="28" VerticalAlignment="Center" />
              <TextBlock Text="Recent" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" />
            </StackPanel>
          </Button>
        </StackPanel>
        
        <!-- Footer -->
        <StackPanel x:Name="SidebarFooterMenu" Grid.Row="2" Margin="12,0,12,16">
          <Separator Background="{DynamicResource BorderBrush}" Margin="0,8" />
          
          <Button Click="CredentialsClick" Style="{StaticResource NavigationButton}" ToolTip="Manage Credentials">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="28" VerticalAlignment="Center" />
              <TextBlock Text="Credentials" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" />
            </StackPanel>
          </Button>
          <Button Click="SettingsClick" Style="{StaticResource NavigationButton}" ToolTip="Settings">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="28" VerticalAlignment="Center" />
              <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" />
            </StackPanel>
          </Button>
          <Button Click="DiagnosticsClick" Style="{StaticResource NavigationButton}" ToolTip="Diagnostics">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="28" VerticalAlignment="Center" />
              <TextBlock Text="Diagnostics" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" />
            </StackPanel>
          </Button>
          
          <TextBlock x:Name="SidebarFooter"
                     Text="Your remote workspace"
                     Foreground="{DynamicResource MutedTextBrush}"
                     FontSize="11"
                     Margin="12,16,0,4"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
    
    <!-- Main Content -->
    <Grid x:Name="LibrarySurface" Grid.Column="1" Margin="24,20,24,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      
      <!-- Header -->
      <Grid Grid.Row="0" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Library" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border Background="{DynamicResource SurfaceRaisedBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource CornerRadiusFull}"
                  Padding="12,4"
                  Margin="16,0,0,0"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding CountLabel}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="13"
                       FontWeight="Medium" />
          </Border>
        </StackPanel>
        
        <WrapPanel Grid.Column="1" Margin="0,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
          <Button Command="{Binding RefreshCommand}"
                  ToolTip="Refresh library"
                  Style="{DynamicResource GhostButton}"
                  Padding="12,8">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
          </Button>
          <Button Command="{Binding ToggleViewCommand}"
                  ToolTip="Switch tile / list view"
                  Style="{DynamicResource GhostButton}"
                  Padding="12,8"
                  Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding IsListView, Converter={StaticResource ViewToIcon}}"
                         FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="View" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
          </Button>
          <Button Click="ImportClick"
                  ToolTip="Import VMs from a JSON export"
                  Style="{DynamicResource GhostButton}"
                  Padding="12,8"
                  Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="Import" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
          </Button>
          <Button Click="ExportClick"
                  ToolTip="Export the library to JSON"
                  Style="{DynamicResource GhostButton}"
                  Padding="12,8"
                  Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="Export" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
          </Button>
          <Button Click="BackupClick"
                  ToolTip="Back up library and settings"
                  Style="{DynamicResource GhostButton}"
                  Padding="12,8"
                  Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="Backup" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
          </Button>
          <Button Command="{Binding AddVmCommand}"
                  Style="{DynamicResource PrimaryButton}"
                  Padding="16,8"
                  Margin="16,0,0,0"
                  ToolTip="Add a new VM"
                  MinHeight="42">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Foreground="White" />
              <TextBlock Text="Add VM" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="White" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </Grid>
      
      <!-- Search -->
      <Grid Grid.Row="1" Margin="0,0,0,16">
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Search name, host, or username"
                 FontSize="14"
                 Padding="44,12,16,12"
                 MinHeight="46"
                 Style="{DynamicResource FluentInput}" />
        <TextBlock Text="&#xE721;"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="16"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />
        <TextBlock Text="Search name, host, or username"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="14"
                   Margin="44,0,0,0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SearchText}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      
      <!-- Loading Indicator -->
      <Border Grid.Row="3"
              Style="{DynamicResource Card}"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
              VerticalAlignment="Top"
              Margin="0,0,0,16"
              Padding="24">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Style="{DynamicResource LoadingSpinner}" Width="28" Height="28" />
          <TextBlock Text="Loading VMs..."
                     FontSize="14"
                     Foreground="{DynamicResource MutedTextBrush}"
                     Margin="16,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      
      <!-- Tile View -->
      <ScrollViewer Grid.Row="3"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding IsListView, Converter={StaticResource ViewModeVisibility}, ConverterParameter=Tile}"
                    Padding="0,0,8,0">
        <ItemsControl ItemsSource="{Binding Vms}"
                      ItemTemplate="{StaticResource VmTileTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" ItemWidth="320" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
      
      <!-- List View -->
      <DataGrid Grid.Row="3"
                ItemsSource="{Binding Vms}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                Visibility="{Binding IsListView, Converter={StaticResource ViewModeVisibility}, ConverterParameter=List}"
                Background="{DynamicResource SurfaceBrush}"
                Foreground="{DynamicResource TextBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                RowHeight="52"
                CanUserSortColumns="True"
                CanUserResizeColumns="True"
                SelectionMode="Single"
                SelectionUnit="FullRow">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Name" Width="2.5*" MinWidth="200">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                  <Border Width="32" Height="32" CornerRadius="8"
                          Background="{DynamicResource PrimaryBrush}"
                          Margin="0,0,12,0">
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
<TextBlock FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="Host: {0}:{1}">
                      <Binding Path="Host" />
                      <Binding Path="Port" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Status" Width="160" MinWidth="140">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="10" Height="10"
                           Fill="{Binding State, Converter={StaticResource ConnectionStateBrush}}"
                           VerticalAlignment="Center" />
                  <TextBlock Text="{Binding State, Converter={StaticResource ConnectionStateText}}"
                             FontSize="13"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="1.5*" MinWidth="140" FontSize="13" />
          <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80" FontSize="13" />
          <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="1.5*" MinWidth="120" FontSize="13" />
          <DataGridTemplateColumn Header="Last Connected" Width="1.5*" MinWidth="140">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding LastConnectedAt, StringFormat='{}{0:g}', ConverterCulture='en-US'}"
                           FontSize="13"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridCheckBoxColumn Header="?" Binding="{Binding Favorite}" Width="50" IsReadOnly="False" />
          <DataGridTemplateColumn Header="Actions" Width="140" MinWidth="140">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Content="Connect"
                          Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          Style="{DynamicResource PrimaryButton}"
                          Padding="12,6"
                          FontSize="12"
                          MinHeight="32" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      
      <!-- Empty State -->
      <Border Grid.Row="3"
              Style="{DynamicResource Card}"
              Visibility="{Binding Vms.Count, Converter={StaticResource CountToVisibility}}"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              MaxWidth="480"
              Padding="48">
        <StackPanel Style="{DynamicResource EmptyState}">
          <Border Width="96" Height="96" CornerRadius="48"
                  Background="{DynamicResource PrimaryBrush}"
                  Margin="0,0,0,24"
                  Effect="{DynamicResource ShadowMedium}">
            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                       FontSize="40" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="No VMs yet"
                     Style="{DynamicResource TitleText}"
                     TextAlignment="Center" Margin="0,0,0,8" />
          <TextBlock Text='Choose "Add VM" to save your first remote connection.'
                     Style="{DynamicResource SubtitleText}"
                     TextAlignment="Center"
                     Margin="0,0,0,24" />
          <Button Content="Add your first VM"
                  Command="{Binding AddVmCommand}"
                  Style="{DynamicResource PrimaryButton}"
                  Padding="24,12"
                  MinWidth="200"
                  HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
    
    <!-- Embedded Session Surface -->
    <Grid x:Name="EmbeddedSessionSurface"
          Grid.Column="1"
          Visibility="Collapsed"
          Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      
      <!-- Connection Bar -->
      <Border Grid.Row="0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,12"
              CornerRadius="8,8,0,0">
        <StackPanel Orientation="Horizontal">
          <Button Content="Back to Library"
                  Click="BackToLibraryClick"
                  Style="{DynamicResource GhostButton}"
                  Padding="12,8" />
          <TextBlock x:Name="EmbeddedTitle"
                     FontSize="18"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Margin="16,0,0,0" />
          <Button Content="Reconnect"
                  Click="ReconnectEmbeddedClick"
                  Style="{DynamicResource GhostButton}"
                  Padding="12,8"
                  Margin="24,0,8,0"
                  Visibility="{Binding ElementName=EmbeddedHost, Path=Children.Count, Converter={StaticResource CountToVisibility}}" />
          <Button Content="Disconnect"
                  Click="DisconnectEmbeddedClick"
                  Style="{DynamicResource DangerButton}"
                  Padding="12,8" />
        </StackPanel>
      </Border>
      
      <!-- RDP Host -->
      <Border x:Name="EmbeddedHost"
              Grid.Row="1"
              Background="{DynamicResource WindowBrush}"
              CornerRadius="0,0,8,8"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,1"
              ClipToBounds="True" />
      
      <!-- Status Bar -->
      <TextBlock x:Name="EmbeddedStatus"
                 Grid.Row="2"
                 Text="Embedded session ready"
                 Margin="16,12"
                 Foreground="{DynamicResource MutedTextBrush}"
                 FontSize="13" />
    </Grid>
  </Grid>
</Window>

