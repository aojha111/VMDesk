<Window x:Class="VMDesk.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:VMDesk.App.Converters"
        mc:Ignorable="d"
        Title="VMDesk" Width="1180" Height="760" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Icon="{DynamicResource AppIcon}">
  <Window.Resources>
    <converters:ViewModeVisibilityConverter x:Key="ViewModeVisibility" />
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="236" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14">
        <Button DockPanel.Dock="Top" Content="◀" x:Name="CollapseIcon" Click="CollapseSidebarClick" HorizontalAlignment="Right" ToolTip="Collapse navigation" />
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="8,4,0,28"><Path Data="M2,8 L12,2 L22,8 L22,20 L12,26 L2,20 Z M7,10 L17,10 L17,17 L7,17 Z" Fill="{DynamicResource PrimaryBrush}" Stretch="Uniform" Width="28" Height="28"/><TextBlock x:Name="SidebarText" Text="VMDesk" FontSize="26" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
          <StackPanel x:Name="SidebarMenu">
            <Button Tag="All" Click="ScopeClick" HorizontalContentAlignment="Left" Background="{DynamicResource SurfaceRaisedBrush}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="All VMs"/></StackPanel></Button>
            <Button Tag="Favorites" Click="ScopeClick" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Favorites"/></StackPanel></Button>
            <Button Tag="Recent" Click="ScopeClick" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Recent"/></StackPanel></Button>
            <Button Tag="Connected" Click="ScopeClick" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Connected"/></StackPanel></Button>
            <Button Tag="Disconnected" Click="ScopeClick" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Disconnected"/></StackPanel></Button>
            <Button Tag="All" Click="ScopeClick" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Groups"/></StackPanel></Button>
            <Button Tag="All" Click="ScopeClick" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Tags"/></StackPanel></Button>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Separator Margin="0,12" Background="{DynamicResource BorderBrush}" />
          <Button Click="CredentialsClick" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Credentials"/></StackPanel></Button>
          <Button Click="SettingsClick" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Settings"/></StackPanel></Button>
          <Button Click="DiagnosticsClick" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Diagnostics"/></StackPanel></Button>
          <TextBlock x:Name="SidebarFooter" Text="Windows desktop VM manager" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid x:Name="LibrarySurface" Grid.Column="1" Margin="30,24,30,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border x:Name="HeroBanner" Background="{DynamicResource HeroStartBrush}" CornerRadius="12" Padding="22" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Remote workspace" FontSize="28" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="Saved connections, credentials, and live sessions" Foreground="#C8EAF4" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Refresh" Command="{Binding RefreshCommand}" />
          <Button Content="Tile / List" Command="{Binding ToggleViewCommand}" />
          <Button Content="+  Add VM" Command="{Binding AddVmCommand}" Background="{DynamicResource PrimaryBrush}" Foreground="White" />
        </StackPanel>
      </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="0,24,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search name, host, user, group, tags, or notes" FontSize="14" />
        <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
        <Button Content="Import" Click="ImportClick"/><Button Content="Export" Click="ExportClick"/><Button Content="Backup" Click="BackupClick"/>
        <Button Click="DiagnosticsClick" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Diagnostics"/></StackPanel></Button>
      </StackPanel>
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsListView, Converter={StaticResource ViewModeVisibility}, ConverterParameter=Tile}">
          <ItemsControl ItemsSource="{Binding Vms}"> 
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="270" MinHeight="190" Margin="0,0,16,16" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="0,0,10,0" />
                      <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE734;" FontFamily="Segoe MDL2 Assets" Padding="6" Margin="0" HorizontalAlignment="Right" Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                  </Grid>
                  <StackPanel Grid.Row="1" Margin="0,18,0,12">
                    <TextBlock Text="{Binding Host}" FontSize="14" />
                    <TextBlock Text="{Binding Port, StringFormat={}{0}}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Username}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Grid Grid.Row="2">
                    <TextBlock Text="Disconnected" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Connect" Padding="10,5" Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                      <Button Content="Edit" Padding="10,5" Tag="{Binding}" Click="EditVmClick" />
                      <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Padding="8,5" Margin="0" Command="{Binding DataContext.DeleteVmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <DataGrid Grid.Row="3" ItemsSource="{Binding Vms}" AutoGenerateColumns="False" IsReadOnly="True" Visibility="{Binding IsListView, Converter={StaticResource ViewModeVisibility}, ConverterParameter=List}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" GridLinesVisibility="None" HeadersVisibility="Column">
          <DataGrid.Columns> 
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
          <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="2*" />
          <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80" />
          <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="1.5*" />
          <DataGridCheckBoxColumn Header="Favorite" Binding="{Binding Favorite}" Width="90" />
          <DataGridTemplateColumn Header="Actions" Width="190">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Connect" Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                  <Button Content="Edit" Tag="{Binding}" Click="EditVmClick" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <Grid x:Name="EmbeddedSessionSurface" Grid.Column="1" Visibility="Collapsed" Margin="18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><Button Content="Back to library" Click="BackToLibraryClick"/><TextBlock x:Name="EmbeddedTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Reconnect" Click="ReconnectEmbeddedClick" Margin="20,0,8,0"/><Button Content="Disconnect" Click="DisconnectEmbeddedClick"/></StackPanel></Border>
      <Grid x:Name="EmbeddedHost" Grid.Row="1" Background="{DynamicResource WindowBrush}"/>
      <TextBlock x:Name="EmbeddedStatus" Grid.Row="2" Text="Embedded session" Margin="12" Foreground="{DynamicResource MutedTextBrush}"/>
    </Grid>
  </Grid>
</Window>