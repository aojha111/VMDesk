<Window x:Class="VMDesk.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:VMDesk.App.Converters"
        mc:Ignorable="d"
        Title="VMDesk" Width="1180" Height="760" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Icon="{DynamicResource AppIcon}">
  <Window.Resources>
    <converters:ViewModeVisibilityConverter x:Key="ViewModeVisibility" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="10,10" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Scope}" Value="All" />
            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="All" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Scope}" Value="Favorites" />
            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Favorites" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Scope}" Value="Recent" />
            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Recent" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="236" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <Button x:Name="CollapseIcon" Click="CollapseSidebarClick" HorizontalAlignment="Left" ToolTip="Collapse navigation" AutomationProperties.Name="Toggle navigation" Width="44" MinHeight="36" Margin="0,0,0,12" HorizontalContentAlignment="Center">
            <Path Data="M 0,4 L 5,9 L 10,4" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="10" Stretch="None" />
          </Button>
          <TextBlock x:Name="SidebarText" Text="VMDesk" FontSize="24" FontWeight="SemiBold" Margin="12,0,0,24" />
        </StackPanel>
        <StackPanel x:Name="SidebarMenu" Grid.Row="1">
          <Button Tag="All" Click="ScopeClick" Style="{StaticResource NavigationButton}" ToolTip="All VMs"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="All VMs"/></StackPanel></Button>
          <Button Tag="Favorites" Click="ScopeClick" Style="{StaticResource NavigationButton}" ToolTip="Favorites"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Favorites"/></StackPanel></Button>
          <Button Tag="Recent" Click="ScopeClick" Style="{StaticResource NavigationButton}" ToolTip="Recent connections"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Recent"/></StackPanel></Button>
        </StackPanel>
        <StackPanel x:Name="SidebarFooterMenu" Grid.Row="2">
          <Separator Margin="0,12" Background="{DynamicResource BorderBrush}" />
          <Button Click="CredentialsClick" Style="{StaticResource NavigationButton}" ToolTip="Credentials"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Credentials"/></StackPanel></Button>
          <Button Click="SettingsClick" Style="{StaticResource NavigationButton}" ToolTip="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Settings"/></StackPanel></Button>
          <Button Click="DiagnosticsClick" Style="{StaticResource NavigationButton}" ToolTip="Diagnostics"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Diagnostics"/></StackPanel></Button>
          <TextBlock x:Name="SidebarFooter" Text="Your remote workspace" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="12,18,0,8" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="LibrarySurface" Grid.Column="1" Margin="28,20,28,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Library" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
          </Border>
        </StackPanel>
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" VerticalAlignment="Center">
          <Button Command="{Binding RefreshCommand}" ToolTip="Refresh library" Padding="10,7" MinHeight="36"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" /><TextBlock Text="Refresh" Margin="7,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Command="{Binding ToggleViewCommand}" ToolTip="Switch tile / list view" Padding="10,7" MinHeight="36"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" /><TextBlock Text="View" Margin="7,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Click="ImportClick" ToolTip="Import VMs from a JSON export" Padding="10,7" MinHeight="36"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" /><TextBlock Text="Import" Margin="7,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Click="ExportClick" ToolTip="Export the library to JSON" Padding="10,7" MinHeight="36"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" /><TextBlock Text="Export" Margin="7,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Click="BackupClick" ToolTip="Back up library and settings" Padding="10,7" MinHeight="36"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" /><TextBlock Text="Backup" Margin="7,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Command="{Binding AddVmCommand}" Background="{DynamicResource PrimaryBrush}" Foreground="White" Padding="14,7" MinHeight="36" Margin="6,0,0,0" ToolTip="Add a new VM"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" /><TextBlock Text="Add VM" Margin="7,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
        </WrapPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,16">
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search name, host, or username" FontSize="14" Padding="36,9,12,9" MinHeight="40" />
        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        <TextBlock Text="Search name, host, or username" Foreground="{DynamicResource MutedTextBrush}" FontSize="14" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SearchText}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsListView, Converter={StaticResource ViewModeVisibility}, ConverterParameter=Tile}">
          <ItemsControl ItemsSource="{Binding Vms}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="280" MinHeight="176" Margin="0,0,14,14" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource PrimaryBrush}"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="14" Padding="6" MinHeight="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Toggle favorite" Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                  </Grid>
                  <StackPanel Grid.Row="1" Margin="0,12,0,10">
                    <TextBlock FontSize="13" TextTrimming="CharacterEllipsis"><Run Text="{Binding Host, Mode=OneWay}" /><Run Text=":" /><Run Text="{Binding Port, Mode=OneWay}" /></TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Username}" Foreground="{DynamicResource MutedTextBrush}" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                  <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="8" Height="8" Fill="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="Disconnected" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                      <Button Content="Connect" Padding="12,5" MinHeight="30" Margin="0" Background="{DynamicResource PrimaryBrush}" Foreground="White" ToolTip="Open an RDP session" Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                      <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Padding="8,5" MinHeight="30" Margin="6,0,0,0" ToolTip="Edit VM" Tag="{Binding}" Click="EditVmClick" />
                      <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Padding="8,5" MinHeight="30" Margin="6,0,0,0" ToolTip="Remove from library" Command="{Binding DataContext.DeleteVmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <DataGrid Grid.Row="3" ItemsSource="{Binding Vms}" AutoGenerateColumns="False" IsReadOnly="True" Visibility="{Binding IsListView, Converter={StaticResource ViewModeVisibility}, ConverterParameter=List}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" GridLinesVisibility="None" HeadersVisibility="Column">
          <DataGrid.Columns> 
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
          <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="2*" />
          <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80" />
          <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="1.5*" />
          <DataGridCheckBoxColumn Header="Favorite" Binding="{Binding Favorite}" Width="90" />
          <DataGridTemplateColumn Header="Actions" Width="190">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Connect" Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                  <Button Content="Edit" Tag="{Binding}" Click="EditVmClick" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="3" Text="No VMs yet. Choose â€œAdd VMâ€ to save your first remote connection." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="40,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Vms.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
    <Grid x:Name="EmbeddedSessionSurface" Grid.Column="1" Visibility="Collapsed" Margin="18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><Button Content="Back to library" Click="BackToLibraryClick"/><TextBlock x:Name="EmbeddedTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Reconnect" Click="ReconnectEmbeddedClick" Margin="20,0,8,0"/><Button Content="Disconnect" Click="DisconnectEmbeddedClick"/></StackPanel></Border>
      <Grid x:Name="EmbeddedHost" Grid.Row="1" Background="{DynamicResource WindowBrush}"/>
      <TextBlock x:Name="EmbeddedStatus" Grid.Row="2" Text="Embedded session" Margin="12" Foreground="{DynamicResource MutedTextBrush}"/>
    </Grid>
  </Grid>
</Window>