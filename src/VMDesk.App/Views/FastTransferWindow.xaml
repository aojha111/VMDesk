<Window x:Class="VMDesk.App.Views.FastTransferWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Fast file transfer" Width="560" Height="300" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
  <StackPanel Margin="26"><TextBlock Text="Fast file transfer" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Uses native RDP redirected drives with asynchronous sequential I/O." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,18" TextWrapping="Wrap"/><TextBlock Text="Remote destination"/><TextBox x:Name="RemoteRootBox" Text="\\tsclient\C\Users\Public\Desktop" Margin="0,5,0,14"/><TextBlock x:Name="FilesLabel" Text="No files selected" Foreground="{DynamicResource MutedTextBrush}"/><ProgressBar x:Name="Progress" Height="8" Margin="0,14,0,18" Minimum="0" Maximum="100"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Choose files" Click="ChooseClick"/><Button Content="Start transfer" Click="StartClick" Background="{DynamicResource PrimaryBrush}" Foreground="White"/><Button Content="Close" Click="CloseClick"/></StackPanel></StackPanel>
</Window>