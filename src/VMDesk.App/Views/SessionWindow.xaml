<Window x:Class="VMDesk.App.Views.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VMDesk Session"
        Width="1400"
        Height="900"
        MinWidth="1024"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        Icon="{DynamicResource Icon.App}"
        WindowState="Maximized">

    <Window.Resources>
        <Style x:Key="ConnectionBarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style x:Key="ConnectionBarPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection Bar (Top) -->
        <Border x:Name="ConnectionBar"
                Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Visibility="Visible">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: VM Info & Window Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8"
                            Background="{DynamicResource PrimaryBrush}"
                            Margin="0,0,12,0">
                        <Rectangle Style="{StaticResource TintedPackIcon}" Width="18" Height="18"
                                   Fill="White" HorizontalAlignment="Center">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{StaticResource Icon.Vm}" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SessionTitleText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="SessionSubtitleText"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: Connection Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator"
                             Width="10" Height="10"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="StatusText"
                               Text="Disconnected"
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LatencyText"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </StackPanel>

                <!-- Right: Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ClipboardButton"
                            Style="{StaticResource ConnectionBarButton}"
                            ToolTip="Toggle clipboard redirection"
                            Click="ClipboardButton_Click">
                        <Image Source="{StaticResource Icon.Clipboard}" Style="{StaticResource PackIcon}"
                               Width="18" Height="18" />
                    </Button>
                    <Button x:Name="AudioButton"
                            Style="{StaticResource ConnectionBarButton}"
                            ToolTip="Toggle audio redirection"
                            Click="AudioButton_Click"
                            Margin="4,0,0,0">
                        <Image Source="{StaticResource Icon.Audio}" Style="{StaticResource PackIcon}"
                               Width="18" Height="18" />
                    </Button>
                    <Button x:Name="FullscreenButton"
                            Style="{StaticResource ConnectionBarButton}"
                            ToolTip="Toggle fullscreen (F11)"
                            Click="FullscreenButton_Click"
                            Margin="4,0,0,0">
                        <Image Source="{StaticResource Icon.Fullscreen}" Style="{StaticResource PackIcon}"
                               Width="18" Height="18" />
                    </Button>
                    <Button x:Name="SendCtrlAltDelButton"
                            Style="{StaticResource ConnectionBarButton}"
                            ToolTip="Send Ctrl+Alt+Del (Ctrl+Alt+End)"
                            Click="SendCtrlAltDelButton_Click"
                            Margin="4,0,0,0">
                        <Image Source="{StaticResource Icon.Lock}" Style="{StaticResource PackIcon}"
                               Width="18" Height="18" />
                    </Button>
                    <Button x:Name="FileTransferButton"
                            Style="{StaticResource ConnectionBarPrimaryButton}"
                            ToolTip="File transfer (upload/download)"
                            Click="FileTransferButton_Click"
                            Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Style="{StaticResource TintedPackIcon}"
                                       Width="18" Height="18" Fill="White">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{StaticResource Icon.Transfer}" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Files"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DisconnectButton"
                            Style="{DynamicResource DangerButton}"
                            Content="Disconnect"
                            Click="DisconnectClick"
                            Padding="16,8"
                            Margin="12,0,0,0"
                            MinWidth="100" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- RDP Host Area -->
        <Border x:Name="HostContainer"
                Grid.Row="1"
                Background="{DynamicResource WindowBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0"
                ClipToBounds="True"
                Focusable="True">
            <!-- Placeholder when not connected -->
            <Grid x:Name="PlaceholderGrid"
                  Visibility="Visible"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="96" Height="96" Margin="0,0,0,24">
                        <Border Width="96" Height="96" CornerRadius="48"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Effect="{DynamicResource ShadowMedium}" />
                        <Border Width="96" Height="96" CornerRadius="48"
                                Background="{DynamicResource SurfaceRaisedBrush}">
                            <Image Source="{StaticResource Icon.Vm}" Style="{StaticResource PackIcon}"
                                   Width="40" Height="40" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="PlaceholderTitle"
                               Text="Connecting..."
                               Style="{DynamicResource TitleText}"
                               TextAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock x:Name="PlaceholderMessage"
                               Text="Establishing secure connection..."
                               Style="{DynamicResource SubtitleText}"
                               TextAlignment="Center"
                               Margin="0,0,0,24" />
                    <ContentControl x:Name="ConnectingSpinner"
                                    Template="{DynamicResource LoadingSpinnerTemplate}"
                                    HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar (Bottom) -->
        <Border x:Name="StatusBar"
                Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8"
                Height="44">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ResolutionText"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" | "
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0" />
                    <TextBlock x:Name="ColorDepthText"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TimeText"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Fullscreen Overlay Hint -->
        <Border x:Name="FullscreenHint"
                Grid.RowSpan="3"
                Background="{DynamicResource OverlayBrush}"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="0,40,0,0">
                <Border Padding="16,8"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="{DynamicResource CornerRadiusMedium}"
                        Effect="{DynamicResource ShadowMedium}" />
                <Border Padding="16,8"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="{DynamicResource CornerRadiusMedium}">
                    <TextBlock Text="Press F11 or hover top center to exit fullscreen"
                               FontSize="14"
                               Foreground="White" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

