<Window x:Class="VMDesk.App.Views.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VMDesk session" Width="1200" Height="800" WindowStartupLocation="CenterOwner" Background="#050608">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" Padding="12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Disconnect" Click="DisconnectClick" />
        <Button DockPanel.Dock="Right" Content="Upload files" Click="UploadFilesClick" />
        <Button DockPanel.Dock="Right" Content="Copy files" Click="CopyFilesClick" />
        <Button DockPanel.Dock="Right" Content="Clipboard" Click="ClipboardClick" />
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Grid x:Name="HostContainer" Background="{DynamicResource WindowBrush}" />
  </DockPanel>
</Window>