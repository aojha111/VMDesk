<Window x:Class="VMDesk.App.Views.CredentialManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Credential Manager" Width="900" Height="600" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Credential manager" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Saved credentials stay in Windows Credential Manager and never enter VMDesk exports." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,20" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
      <ListBox x:Name="CredentialsList" ItemsSource="{Binding Credentials}" SelectionChanged="SelectionChanged" Margin="0,0,18,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
        <ListBox.ItemTemplate><DataTemplate><Border Padding="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Reference}" FontWeight="SemiBold"/><TextBlock Text="{Binding Username}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/><TextBlock Text="{Binding LastWritten, StringFormat=Updated {0:g}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="1" Padding="20" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <StackPanel>
          <TextBlock Text="Save or update" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
          <TextBlock Text="Credential name"/><TextBox x:Name="LabelBox" Margin="0,5,0,12"/>
          <TextBlock Text="Username"/><TextBox x:Name="UsernameBox" Margin="0,5,0,12"/>
          <TextBlock Text="New password"/><PasswordBox x:Name="PasswordBox" Margin="0,5,0,18"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="Save / update" Click="SaveClick" Background="{DynamicResource PrimaryBrush}" Foreground="White" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Delete" Click="DeleteClick" Margin="0"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Use selected" Click="UseClick"/><Button Content="Close" IsCancel="True" Click="CloseClick" Margin="0"/></StackPanel>
  </Grid>
</Window>