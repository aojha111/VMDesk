<Window x:Class="VMDesk.App.Views.AddVmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add VM"
        Width="640"
        Height="760"
        MinWidth="560"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        Icon="{DynamicResource AppIcon}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{DynamicResource Card}" Margin="24" Padding="0">
            <StackPanel Margin="32,28,32,24">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TitleText"
                                   Text="Add virtual machine"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Credentials live in Windows Credential Manager; the password is never entered here."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- Name Field -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Name" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="NameBox"
                             Padding="14,12"
                             MinHeight="46"
                             FontSize="14"
                             ToolTip="A friendly name for this VM" />
                </StackPanel>

                <!-- Host Field -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Host or IP address" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="HostBox"
                             Padding="14,12"
                             MinHeight="46"
                             FontSize="14"
                             ToolTip="Hostname or IP address of the remote machine" />
                </StackPanel>

                <!-- Username & Port -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Username (optional if credential is selected)" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="UserBox" Padding="14,12" MinHeight="46" FontSize="14" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Port (optional)" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="PortBox" Padding="14,12" MinHeight="46" FontSize="14"
                                 ToolTip="Leave empty to use the standard RDP port 3389" />
                    </StackPanel>
                </Grid>

                <!-- Credential Field -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Credential" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CredentialBox"
                                  DisplayMemberPath="Reference"
                                  SelectedIndex="0"
                                  Padding="14,10"
                                  MinHeight="46"
                                  FontSize="14" />
                        <Button Grid.Column="1"
                                Click="ManageCredentialsClick"
                                Margin="10,0,0,0"
                                Width="46" Height="46"
                                Style="{DynamicResource IconButton}"
                                ToolTip="Manage saved credentials"
                                AutomationProperties.Name="Manage saved credentials">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Options -->
                <StackPanel Margin="0,4,0,0">
                    <CheckBox x:Name="SeparateWindowBox"
                              Content="Launch this VM in a separate window"
                              Margin="0,0,0,0"
                              IsChecked="True"
                              FontSize="13" />
                    <CheckBox x:Name="DriveRedirectBox"
                              Content="Enable redirected drives for fast file transfers"
                              Margin="0,10,0,0"
                              FontSize="13" />
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                    <Button Content="Cancel"
                            IsCancel="True"
                            Style="{StaticResource SecondaryButton}"
                            Padding="20,10"
                            MinWidth="100" />
                    <Button x:Name="AddButton"
                            IsDefault="True"
                            Style="{DynamicResource PrimaryButton}"
                            Padding="24,10"
                            MinWidth="120"
                            Margin="12,0,0,0"
                            Click="AddClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="White"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Add VM"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
