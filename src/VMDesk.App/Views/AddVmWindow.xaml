<Window x:Class="VMDesk.App.Views.AddVmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add VM" Width="620" Height="740" MinWidth="540" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Border Margin="24" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
    <StackPanel Margin="28,24,28,20">
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Add virtual machine" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="Credentials live in Windows Credential Manager; the password is never entered here." Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

      </Grid>

      <TextBlock Text="Name" Margin="0,0,0,5" />
      <TextBox x:Name="NameBox" Margin="0,0,0,16" Padding="10" />

      <TextBlock Text="Host or IP address" Margin="0,0,0,5" />
      <TextBox x:Name="HostBox" Margin="0,0,0,16" Padding="10" />

      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="110" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,10,0">
          <TextBlock Text="Username (optional if credential is selected)" Margin="0,0,0,5" />
          <TextBox x:Name="UserBox" Padding="10" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Port" Margin="0,0,0,5" />
          <TextBox x:Name="PortBox" Text="3389" Padding="10" />
        </StackPanel>
      </Grid>

      <TextBlock Text="Credential" Margin="0,4,0,5" />
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="CredentialBox" DisplayMemberPath="Reference" SelectedIndex="0" />
        <Button Grid.Column="1" Click="ManageCredentialsClick" Margin="10,0,0,0" Width="40" Height="40" Padding="8" AutomationProperties.Name="Manage saved credentials" ToolTip="Manage saved credentials" Content="..." Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextBrush}" />
      </Grid>

      <CheckBox x:Name="SeparateWindowBox" Content="Launch this VM in a separate window" Margin="0,4,0,0" IsChecked="True" />
      <CheckBox x:Name="DriveRedirectBox" Content="Enable redirected drives for fast file transfers" Margin="0,10,0,0" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
        <Button Content="Cancel" IsCancel="True" />
        <Button Content="Add VM" IsDefault="True" Background="{DynamicResource PrimaryBrush}" Foreground="White" Click="AddClick" />
      </StackPanel>
    </StackPanel>
  </Border>
  </ScrollViewer>
</Window>