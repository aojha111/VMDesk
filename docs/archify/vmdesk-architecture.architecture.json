  "cards": [
    {
      "dot": "cyan",
      "title": "Connect lifecycle",
      "items": [
        "RdpControlFactory pre-validates each coclass with a real CoCreateInstance",
        "GetOcx deferred until the control has a window handle — parent, then dial",
        "Re-parenting an AxHost after Connect() orphans the HWND and the dial no-ops"
      ]
    },
    {
      "dot": "rose",
      "title": "Secrets",
      "items": [
        "Passwords live only in Windows Credential Manager (target VMDesk/{vmId})",
        "CredSSP + NLA negotiated in-process; never written to disk or logs"
      ]
    },
    {
      "dot": "emerald",
      "title": "State & QA",
      "items": [
        "Hypervisor probes fail soft: unavailable providers never break the library",
        "VM records, history and settings persist in SQLite via EF Core",
        "150 unit tests plus a UIAutomation E2E harness with a local TCP dial sink"
      ]
    }
  ]
